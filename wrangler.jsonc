{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metaearthwave",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "alias": {
    "next/headers": "./cloudflare/next-headers.ts"
  },
  "routes": [
    {
      "pattern": "meta-earth-wave.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
