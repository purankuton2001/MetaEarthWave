# Copy to .env.local. A key is required for emotion analysis; no demo fallback is used.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-latest

# Optional original live feed
NEXT_PUBLIC_WEBSOCKET_URL=

# Server-side live Japanese X trends (15-minute cache)
TREG_TOKEN=
# Required for an identity token; use your own active team slug.
TREG_ORG=
